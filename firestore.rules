rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection: Publicly readable; writable only by the authenticated owner
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Sellers collection: Publicly readable; writable by the seller owner or admin
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == sellerId || request.auth.token.admin == true);
    }

    // Products collection: Publicly readable; writable by authenticated sellers
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders collection: Publicly readable; creation open for checkout; update by authenticated users/sellers
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null;
    }

    // Reviews collection: Publicly readable; creation requires authentication
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Wishlist items collection: Requires authentication for user wishlists
    match /wishlist_items/{itemId} {
      allow read, write: if request.auth != null;
    }

    // Notifications collection: Publicly accessible for realtime in-app alerts
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Platform settings & seed status
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

